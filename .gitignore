models/
huggingface/
.cache/

# Virtual Environments
.venv/
venv/
env/
ENV/
*.env

# IDE and Editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary & Log files
*.log
*.tmp
*.temp
DUMP*
